---
import { waqafState as w, rupiah, persenID } from '../data/waqaf';
---
  <section id="hero" style="background:#0D1B4B !important; position:relative; min-height:100vh; display:flex; align-items:center;">
    
    <div style="position:absolute;inset:0;background:linear-gradient(
      135deg,rgba(13,27,75,0.96) 0%,rgba(13,27,75,0.85) 55%,
      rgba(13,27,75,0.72) 100%);z-index:0;pointer-events:none;"></div>

    <div id="hero-container" style="position:relative;z-index:1;" class="max-w-[1240px] mx-auto px-6 md:px-12 w-full pt-28 md:pt-32 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Kolom Kiri - Story & Heading -->
        <div class="lg:col-span-7 flex flex-col items-start text-left">
          
          <div id="hero-badge" class="reveal inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gold/10 mb-6" style="color:#B8963E; border: 1px solid rgba(201,168,76,0.4);">
            <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
            <span class="text-[11px] font-semibold tracking-wider text-gold uppercase">Pembangunan Aktif · 2026</span>
          </div>

          <blockquote class="reveal reveal-delay-1 border-l-2 pl-4 mb-8" style="color:rgba(255,255,255,0.75); border-left-color:#B8963E;">
            <p class="font-display italic text-sm md:text-base leading-relaxed">
              "Siapa yang membangun masjid karena Allah, maka Allah bangunkan baginya rumah di Surga."
            </p>
            <cite class="block mt-2 text-xs font-semibold uppercase tracking-wider text-white/40 not-italic">(H.R. Bukhari & Muslim)</cite>
          </blockquote>

          <h1 class="reveal reveal-delay-2 font-display text-[2rem] sm:text-[2.5rem] md:text-[3.25rem] lg:text-[4.25rem] font-bold leading-tight" style="color:#ffffff !important;">
            Masjid Jami<br>
            <span style="color:#B8963E !important;">Ar-Rustendi</span>
          </h1>

          <svg height="8" viewBox="0 0 200 8" class="reveal reveal-delay-3 my-6 text-gold opacity-60 w-48">
            <path d="M0 4 Q50 1 100 4 Q150 7 200 4" stroke="currentColor" stroke-width="2" fill="none"/>
          </svg>

          <p class="reveal reveal-delay-3 text-sm md:text-base leading-relaxed mb-8 max-w-xl" style="color:rgba(255,255,255,0.7) !important;">
            Menghadirkan rumah ibadah yang asri, nyaman, dan representatif bagi warga Kp. Rumpin Tegal Indah, Bogor. Bergabunglah menanam investasi akhirat (amal jariyah) yang pahalanya terus mengalir tanpa terputus.
          </p>

          <!-- Progress bar Mini -->
          <div class="reveal reveal-delay-4 w-full max-w-xl hero-progress-card mb-9">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-3">
              <span id="hero-progress-label" class="text-[11px] uppercase font-bold tracking-[0.1em]" style="color:rgba(255,255,255,0.62) !important;">Dana Progres (Modal + Donasi)</span>
              <span id="hero-progress-val" class="tnum" style="color:#ffffff !important;"><span id="hero-progress-text" class="hero-progress-num">{persenID(w.persen)}</span><span class="hero-progress-pct">%</span> <span class="hero-progress-sep">·</span> <span id="hero-progress-amount" class="hero-progress-amt">{rupiah(w.danaProgres)}</span></span>
            </div>
            <div id="hero-progress-bg" style="background:rgba(255,255,255,0.16); height:10px; border-radius:99px;" class="w-full overflow-hidden">
              <div id="hero-progress-bar" style="background:#B8963E; width:100%; height:100%; border-radius:99px; clip-path:inset(0 100% 0 0); transition:clip-path 1.5s cubic-bezier(0.23,1,0.32,1) 0.4s;"></div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="reveal reveal-delay-5 flex flex-wrap gap-3.5">
            <a href="https://kitabisa.com/campaign/wakafmumesempurnakanmasjidimpiansantrirumpinbogor" target="_blank" class="btn-gold btn-hero rounded-full inline-flex items-center justify-center gap-2.5">
              <span>Donasi via Kitabisa</span>
              <i data-lucide="external-link" class="w-[18px] h-[18px]"></i>
            </a>
            <a href="#donasi" class="btn-ghost btn-hero rounded-full inline-flex items-center justify-center gap-2.5">
              <span>Transfer Bank</span>
              <i data-lucide="arrow-right" class="w-[18px] h-[18px]"></i>
            </a>
          </div>
        </div>

        <!-- Kolom Kanan - Rendering Glass Panel -->
        <div class="lg:col-span-5 relative overflow-hidden">
          <div id="hero-glass-card" class="reveal reveal-delay-3 glass rounded-2xl p-6 md:p-8">
            <span class="block text-[11px] font-bold text-gold uppercase tracking-wider mb-4">Visualisasi Arsitektur</span>
            
            <div class="img-card rounded-xl aspect-[4/3] mb-6 overflow-hidden relative shadow-xs">
              <img 
                src="/images/render-tampak-depan-malam.jpg" 
                alt="Render 3D Masjid Jami Ar-Rustendi tampak depan" 
                class="w-full h-full object-cover"
                loading="eager"
              >
              <div class="absolute bottom-3 right-3 px-2.5 py-1 bg-navy-deepest/70 rounded text-[10px] text-gold font-semibold uppercase border border-gold/10 z-10">Deay Arsitektur</div>
            </div>

            <!-- Stats Grid -->
            <div class="hero-stats pt-4 border-t border-white/10">
              <div class="text-center">
                <span class="block font-display text-base md:text-lg font-bold text-gold">168 m²</span>
                <span class="block text-[10px] text-white/50 uppercase font-semibold mt-1">Luas Tanah</span>
              </div>
              <div class="w-px h-8 bg-white/10 mx-auto self-center"></div>
              <div class="text-center">
                <span class="block font-display text-base md:text-lg font-bold text-gold">4 Tahap</span>
                <span class="block text-[10px] text-white/50 uppercase font-semibold mt-1">Roadmap</span>
              </div>
              <div class="w-px h-8 bg-white/10 mx-auto self-center"></div>
              <div class="text-center">
                <span class="block font-display text-base md:text-lg font-bold text-gold">2026</span>
                <span class="block text-[10px] text-white/50 uppercase font-semibold mt-1">Target</span>
              </div>
            </div>
          </div>
          
          <!-- Decorative element subtle glow -->
          <div class="absolute -top-12 -right-12 w-64 h-64 bg-gold/10 rounded-full blur-3xl -z-10 pointer-events-none"></div>
        </div>
      </div>
    </div>

  </section>

