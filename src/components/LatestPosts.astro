---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';

const byDate = <T extends { data: { date: Date } }>(a: T, b: T) => b.data.date.getTime() - a.data.date.getTime();
const berita = (await getCollection('berita', (p) => !p.data.draft)).sort(byDate).slice(0, 3);
const artikel = (await getCollection('artikel', (p) => !p.data.draft)).sort(byDate).slice(0, 3);
---
<section id="kabar" class="py-24 md:py-32 bg-offwhite">
  <div class="max-w-[1240px] mx-auto px-6 md:px-12">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="section-label">Kabar &amp; Wawasan</span>
      <div class="divider-gold mx-auto mt-3 mb-4"></div>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-navy-primary">Berita &amp; Artikel</h2>
      <p class="text-gray-500 text-sm md:text-base mt-4">Kabar terbaru pembangunan dan bacaan seputar sedekah, wakaf, dan memakmurkan masjid.</p>
    </div>

    <div class="flex items-end justify-between mb-5">
      <h3 class="font-display text-xl font-bold text-navy-primary">Berita Pembangunan</h3>
      <a href="/berita" class="text-xs font-bold uppercase tracking-wider text-navy-primary hover:text-gold-ink">Semua berita →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mb-14">
      {berita.map((p) => <PostCard href={`/berita/${p.id}`} title={p.data.title} description={p.data.description} date={p.data.date} image={p.data.image} imageAlt={p.data.imageAlt} label="Berita" />)}
    </div>

    <div class="flex items-end justify-between mb-5">
      <h3 class="font-display text-xl font-bold text-navy-primary">Artikel Sedekah Masjid</h3>
      <a href="/artikel" class="text-xs font-bold uppercase tracking-wider text-navy-primary hover:text-gold-ink">Semua artikel →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {artikel.map((p) => <PostCard href={`/artikel/${p.id}`} title={p.data.title} description={p.data.description} date={p.data.date} image={p.data.image} imageAlt={p.data.imageAlt} label={p.data.category} />)}
    </div>
  </div>
</section>
