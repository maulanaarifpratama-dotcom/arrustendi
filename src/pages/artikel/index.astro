---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('artikel', (p) => !p.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Artikel Sedekah Masjid dan Manfaatnya | Masjid Jami Ar-Rustendi" description="Bacaan seputar sedekah, wakaf, dan keutamaan memakmurkan masjid, lengkap dengan dalil dan panduan berdonasi." solidHeader>
  <main class="pt-32 pb-24 bg-offwhite min-h-screen">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <span class="section-label">Wawasan</span>
      <div class="divider-gold mt-3 mb-4"></div>
      <h1 class="font-display text-3xl md:text-5xl font-bold text-navy-primary">Artikel Sedekah Masjid</h1>
      <p class="text-gray-500 mt-4 max-w-2xl">Keutamaan, manfaat, dan panduan sedekah untuk pembangunan masjid.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {posts.map((p) => <PostCard href={`/artikel/${p.id}`} title={p.data.title} description={p.data.description} date={p.data.date} image={p.data.image} imageAlt={p.data.imageAlt} label={p.data.category} />)}
      </div>
    </div>
  </main>
</Base>
